rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {
    // ── Sucursales ─────────────────────────────────────────────────────
    // Metadata pública: el selector de sucursal de la web la lee sin sesión.
    // La edición es solo del admin, igual que los demás ABM: desactivar una
    // sucursal desde la consola del navegador cortaría los pedidos web.
    match /sucursales/{sucursal} {
      allow read: if true;
      allow write: if esAdmin();

      // Pedidos: la web pública crea solicitudes validadas y lee UN pedido por id
      // (/ver-pedido). `get` y `list` van separados a propósito: `read` cubría los
      // dos, y como esOrigenWeb() se evalúa documento por documento, una query
      // where("origen","==","WEB") la satisfacía y devolvía sin sesión nombre,
      // teléfono y dirección de toda la clientela web. PaginaDetalle usa getDoc,
      // así que el público nunca necesitó `list`.
      match /pedidos/{pedido} {
        allow get: if estaAutenticado() || (esOrigenWeb() && sigueVisibleParaElPublico());
        allow list: if estaAutenticado();
        allow create: if estaAutenticado() || esCreacionPublicaValida();
        allow update: if estaAutenticado() && asignacionValida() && !anulaViajeEnLaCalle();
        allow delete: if false;
      }

      // Colecciones operativas (resumenDiario, contadores, asistencias): solo staff.
      // Excluye pedidos: las reglas se combinan con OR y este wildcard
      // re-otorgaría el delete bloqueado arriba.
      //
      // OJO: `asistencias` cae acá, así que cualquier staff autenticado puede leer
      // y escribir los sueldos. Se dejó así cuando una regla por rol costaba un
      // get() facturado; con los custom claims ese costo desapareció, así que
      // cerrarlo ahora es gratis: hace falta un claim `encargado` y excluir
      // `asistencias` de este wildcard, igual que se hace con `pedidos`.
      match /{coleccion}/{documento} {
        allow read, write: if estaAutenticado() && coleccion != 'pedidos';
      }
    }


    // Colecciones Públicas
    match /productos/{producto} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /categorias/{categoria} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /envios/{envio} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Otras Colecciones
    // Empleados. Cualquier staff puede LEER (la Caja necesita nombres, el
    // encargado la lista de su sucursal), pero escribir es SOLO del admin: un
    // `write` abierto dejaba que un cajero se pusiera rol admin editando su
    // propio documento desde la consola del navegador.
    //
    // Nadie edita su propio perfil: Mi Perfil es de solo lectura y si un dato
    // está mal lo corrige el administrador. Lo único que el empleado cambia por
    // su cuenta es la contraseña, y eso va por Auth, no por Firestore.
    //
    // El alta CON acceso la hace la Cloud Function con Admin SDK, que se saltea
    // las reglas; este write cubre a los empleados sin acceso (repartidores),
    // que los escribe el cliente desde PanelAdmin.
    match /usuarios/{usuario} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }
    match /clientes/{cliente} {
      allow read, write: if estaAutenticado();
    }


    // Funciones Aux
    function esCreacionPublicaValida() {
      let data = request.resource.data;
      return data.origen == "WEB"
        && data.estado == "PENDIENTE"
        && data.keys().hasAll(["cliente", "carrito", "total", "estado", "origen", "clienteTimestamp"])
        && !data.keys().hasAny(["cajeroID", "cocineroID", "deliveryID"])
        && data.carrito is list
        && data.carrito.size() > 0
        && data.carrito.size() <= 50
        && data.total is number
        && data.total > 0
        && data.total <= 1000000;
    }

    function esOrigenWeb() {
      return resource.data.origen == "WEB";
    }

    // El link público de un pedido vence a las 48 horas. El registro no se toca:
    // el staff lo sigue viendo y el cliente ya no. No cuesta lecturas: compara la
    // hora del pedido con la de la consulta.
    function sigueVisibleParaElPublico() {
      return request.time < resource.data.clienteTimestamp + duration.value(48, 'h');
    }

    // Una solicitud web tiene un solo dueño. `cajeroRevisaID` solo se puede
    // escribir si estaba libre o ya era de quien escribe (retomar, liberar,
    // guardar). Compara resource (lo que hay) con request.resource (lo que se
    // quiere escribir): no cuesta lecturas.
    //
    // Cierra la carrera entre dos cajeros cuyos listeners todavía no recibieron
    // la asignación del otro: el front chequeaba contra el snapshot local y los
    // dos pasaban, los dos cargaban el pedido y el arqueo lo sumaba dos veces.
    // Toda escritura que no toque el campo pasa igual (despues == antes).
    //
    // Una toma abandonada se libera sola (asignacionVencida): pasados 15 minutos
    // desde que se tomó, cualquiera puede tomarla. Una toma nueva reescribe la hora,
    // así que el que la tomó último queda protegido otros 15 minutos, incluso del
    // cajero original si vuelve e intenta guardar.
    function asignacionValida() {
      let antes = resource.data.get('cajeroRevisaID', null);
      let despues = request.resource.data.get('cajeroRevisaID', null);
      return despues == antes || antes == null || antes == request.auth.uid
        || asignacionVencida();
    }

    // Mismo valor que MINUTOS_SOLICITUD_TOMADA en Constantes.jsx: si cambia uno,
    // cambiar el otro. Una toma sin hora (anterior a este cambio) cuenta como
    // vencida: si no, quedaría trabada para siempre. No cuesta lecturas: compara la
    // hora guardada con la de la escritura.
    function asignacionVencida() {
      let tomada = resource.data.get('cajeroRevisaTimestamp', null);
      return tomada == null || request.time > tomada + duration.value(15, 'm');
    }

    // Un viaje en la calle no se anula: el pedido saldría de la lista de la jefa de
    // deliverys, no podría marcar que volvió y el envío no se le pagaría al repartidor.
    // F3 y el Historial ya lo bloquean (enLaCalle() en useResumenDiario.js); esto cubre
    // una Caja que no se recargó o una escritura desde la consola del navegador.
    // Mismos valores que ESTADOS y SUBESTADOS_MOTODELIVERY en Constantes.jsx: si
    // cambian allá, cambiar acá. No cuesta lecturas: compara el pedido con el cambio.
    function anulaViajeEnLaCalle() {
      return resource.data.get('estado', null) == 'DELIVERY'
        && resource.data.get('estadoDelivery', null) == 'SALIO'
        && request.resource.data.get('estado', null) in ['ELIMINADO', 'CANCELADO'];
    }

    function estaAutenticado() {
      return request.auth != null;
    }

    // Ser admin va en un custom claim del token, no en un get() a Firestore:
    // evaluar la regla no cuesta ninguna lectura. Lo reparte la Cloud Function
    // sincronizarClaims, que se corre tras crear un admin desde la Consola.
    // Ojo: el claim viaja en el token, así que toma efecto al re-loguearse.
    function esAdmin() {
      return estaAutenticado() && request.auth.token.admin == true;
    }
  }
}
